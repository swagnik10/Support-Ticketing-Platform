{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "/app/logs/support_ticket_platform_log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=<Host_Name>;Port=<Port>;Database=helpdesk_db;Username=<User_Name>;Password=<Db_Password>;SSL Mode=Require;Trust Server Certificate=true;"
  },
  "AllowedHosts": "*"
}
